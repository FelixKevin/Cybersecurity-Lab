{
  "baseUrl": "https://canvas.ehb.be",
  "courseId": null,
  "contentDir": "content",
  "template": "template.html",
  "cssFile": "css/style.css",
  "inlineCss": true,
  "classPrefix": "ti_",
  "sectionHeading": "h2",
  "headingMap": {
    "h2": "h3",
    "h3": "h5",
    "h4": "h6"
  },
  "backToTopText": "↑",
  "backToTopLabel": "Back to top",
  "variantLabels": { "easy": "Easy", "medium": "Medium", "hard": "Hard", "home": "@Home", "extra": "Extra", "letop": "Watch out" },
  "figureLabel": "Figure {n}.",
  "calloutIcons": { "tip": "💡", "info": "ℹ️", "warning": "⚠️" },
  "topId": "ti_top",
  "tocTitle": "Course overview",
  "takeawayPrefix": "What this means for you:",
  "inlineCodeClass": "mono",
  "code": {
    "highlight": true,
    "theme": "github-dark-default",
    "background": "#0d1117",
    "aliases": {
      "js": "javascript",
      "ts": "typescript",
      "sh": "bash",
      "shell": "bash",
      "zsh": "bash",
      "ps": "powershell",
      "ps1": "powershell",
      "cs": "csharp",
      "c#": "csharp",
      "py": "python",
      "yml": "yaml",
      "md": "markdown"
    },
    "outputLangs": [
      "console",
      "output",
      "text",
      "txt"
    ],
    "outputLabel": "Output",
    "labels": {
      "javascript": "JavaScript",
      "typescript": "TypeScript",
      "php": "PHP",
      "bash": "Terminal",
      "powershell": "PowerShell",
      "sql": "SQL",
      "html": "HTML",
      "css": "CSS",
      "json": "JSON",
      "java": "Java",
      "python": "Python",
      "csharp": "C#",
      "yaml": "YAML",
      "xml": "XML",
      "dockerfile": "Dockerfile",
      "markdown": "Markdown",
      "blade": "Blade"
    }
  },
  "callouts": [
    "tip",
    "info",
    "warning"
  ],
  "externalLinksNewTab": true,
  "files": {
    "folder": "course-sync",
    "usageRights": null,
    "hidden": false
  },
  "quizzes": {
    "enabled": true,
    "headingPattern": "^Check yourself\\b",
    "assignmentGroup": "Check yourself",
    "omitFromFinalGrade": true,
    "pointsPerQuestion": 1,
    "shuffleChoices": true,
    "multiAnswerScoring": "PartialScore",
    "matchingScoring": "PartialDeep",
    "instructions": "<p>This test does not count towards your grade. You can take it as often as you like. After submitting, you see for each question whether your answer is correct, with an explanation.</p>",
    "metaText": "{n} questions · not graded · unlimited attempts"
  },
  "blocks": {
    "oefening": {
      "logo": "assets/icons/oefening.svg",
      "linkTarget": "_blank",
      "stripParagraphs": true
    },
    "github": {
      "logo": "assets/icons/code.svg",
      "heading": "GitHub Repo",
      "linkTarget": "_blank"
    },
    "jsfiddle": {
      "logo": "assets/icons/fiddle.svg",
      "heading": "JSFiddle",
      "linkTarget": "_blank"
    },
    "quiz": {
      "logo": "assets/icons/quiz.svg",
      "linkText": "Start the quiz",
      "linkTarget": "_blank"
    }
  },
  "extraTocGroups": [],
  "pdfLinkTitle": "Download this course (PDF)"
}
